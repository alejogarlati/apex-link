# ApexLink Web — Configuración de Entorno Local

# URL de la API REST del Core Relay Kestrel (C# .NET)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL del Servidor WebSocket de Telemetría en Tiempo Real
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/telemetry

# Cadena de conexión directa a PostgreSQL Central (opcional para Server Actions / ORM)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/apexlink
